# Login do painel (mesmo modelo do Precify: usuário/senha fixos + cookie assinado)
PAINEL_USUARIO=michele
PAINEL_SENHA=troque-esta-senha
# Segredo para assinar o cookie de sessão (qualquer texto longo e aleatório)
PAINEL_SEGREDO=gere-um-texto-aleatorio-longo

# Supabase (projeto do Farol). Sem estas variáveis o painel abre com dados de demonstração.
SUPABASE_URL=https://vqrstpxblbicdfloztzh.supabase.co
# Chave JWT da role "painel_leitura" (só enxerga as views ads_painel_*). Ver supabase/README.md
SUPABASE_PAINEL_KEY=
# Service role: usada SOMENTE pela ingestão (rota /api/ingestao e scripts/ingerir-anuncios.ts)
SUPABASE_SERVICE_ROLE_KEY=
# Token que a tarefa agendada usa para chamar POST /api/ingestao
INGESTAO_TOKEN=

# Precify (custo por SKU) — chave com escopo "Produtos", gerada em /chaves-api do Precify
PRECIFY_API_URL=https://<endereco-do-precify>
PRECIFY_API_KEY=
